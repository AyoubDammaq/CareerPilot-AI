# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Your login password for the web app (minimum 12 characters).
AUTH_PASSWORD=change-me-too-at-least-12-chars
# Token signing key (minimum 32 characters), e.g. output of: openssl rand -base64 48
AUTH_JWT_KEY=replace-with-openssl-rand-base64-48-output
