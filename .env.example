# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Your login password for the web app (minimum 12 characters).
AUTH_PASSWORD=change-me-too-at-least-12-chars
# Token signing key (minimum 32 characters), e.g. output of: openssl rand -base64 48
AUTH_JWT_KEY=replace-with-openssl-rand-base64-48-output

# --- Optional ---------------------------------------------------------------------------------
# AI features are off unless a provider is set. The CV text and job posts you ask it to look at are sent to that provider.
# LLM_PROVIDER=Anthropic            # or OpenAiCompatible (also covers a local Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1)
# LLM_MODEL=<model id>
# LLM_API_KEY=<your key>
# LLM_DAILY_CALL_LIMIT=20
# Set to 2 only if you put your own HTTPS reverse proxy in front of the web container.
# SECURITY_FORWARD_LIMIT=1
